.superpowers/
/vendor/
.phpunit.result.cache

# The disposable WordPress the shared harness provisions, plus everything
# else wp-test-env.mjs or the Playwright suite generates. It appears in
# whichever repo runs wp-test-env.mjs, and that includes this one when the
# harness is being worked on — 16,000 files of WordPress core, one
# `git add -A` away from the history.
#
# This repo also keeps its own worked example plugin and Playwright spec
# under .wp-test/ (the harness's default --plugin location), so this is a
# denylist-by-default with an explicit allowlist carved out, rather than the
# other way round — a future file dropped anywhere else under .wp-test/
# (a staged library copy, a generated auth cookie, WordPress itself) is
# ignored automatically, with nothing further to remember. The two earlier
# attempts at this — ignoring the whole tree, then un-ignoring only the
# runtime paths — both left it possible for something generated to become
# committable by accident; only an allowlist over a denylisted tree rules
# that out structurally.
.wp-test/*
!/.wp-test/example-plugin/
/.wp-test/example-plugin/*
!/.wp-test/example-plugin/blueworx-editor-example.php
!/.wp-test/example-plugin/dev-fixture.php
!/.wp-test/tests/
/.wp-test/tests/*
!/.wp-test/tests/page-editor.spec.js

.wp-test-client/
.wp-test-client-plugin/

# Playwright's own run output, and the MCP browser tool's screenshots/logs
# used to eyeball the screen by hand while building it.
/test-results/
/.playwright-mcp/
