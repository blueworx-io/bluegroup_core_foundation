.superpowers/
/vendor/
.phpunit.result.cache

# The disposable WordPress the shared harness provisions. It appears in
# whichever repo runs wp-test-env.mjs, and that includes this one when the
# harness is being worked on — 16,000 files of WordPress core, one `git add -A`
# away from the history. This repo also keeps its own worked example plugin
# and its Playwright spec under .wp-test/ (the harness's default --plugin
# location), so only the runtime WordPress tree and server bookkeeping are
# ignored, not the whole directory.
.wp-test/wp/
.wp-test/*.zip
.wp-test/server.pid
.wp-test/php-server.log
# Signed-in cookies the Playwright spec harvests for itself on each run —
# a live admin session, never a fixture worth keeping in history.
.wp-test/tests/.auth-state.json
.wp-test-client/
.wp-test-client-plugin/

# Playwright's own run output, and the MCP browser tool's screenshots/logs
# used to eyeball the screen by hand while building it.
/test-results/
/.playwright-mcp/
